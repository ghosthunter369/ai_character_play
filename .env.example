RAG_ENABLED=false
EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_ASR_URL=
DASHSCOPE_TTS_URL=
DASHSCOPE_ASR_MODEL=
DASHSCOPE_TTS_MODEL=
DASHSCOPE_VOICE=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_ASR_URL=
SILICONFLOW_TTS_URL=
SILICONFLOW_ASR_MODEL=
SILICONFLOW_TTS_MODEL=
SILICONFLOW_VOICE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_BASE_URL=
AZURE_SPEECH_ASR_URL=
AZURE_SPEECH_TTS_URL=
AZURE_SPEECH_VOICE=
